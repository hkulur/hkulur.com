{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hkulur-com",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "hkulur.com", "custom_domain": true },
    { "pattern": "www.hkulur.com", "custom_domain": true }
  ]
}
