---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getEntries, KIND_LABELS, numberLabel } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const words = entry.body?.split(/\s+/).filter(Boolean).length ?? 0;
const minutes = Math.max(1, Math.round(words / 220));
---

<Base title={data.title} description={data.summary}>
  <article>
    <header class="post-head row">
      <div class="rail mono">
        <b>{numberLabel(entry.number)}</b>
        <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time>
        <span>{data.label ?? KIND_LABELS[data.kind]} · {minutes} min</span>
      </div>
      <div class="main">
        <h1>{data.title}</h1>
        <p class="dek">{data.summary}</p>
      </div>
    </header>
    <div class="row">
      <div></div>
      <div class="main prose">
        <Content />
        <p class="back mono"><a href="/">← Back to the log</a></p>
      </div>
    </div>
  </article>
</Base>
